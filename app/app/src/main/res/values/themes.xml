<?xml version="1.0" encoding="utf-8"?>
<!--
  Tema dell'app. Non c'e' la barra del titolo: la pagina deve avere tutto lo
  schermo, come in un browser a schermo intero.

  Il tema vero e proprio sta in "Theme.LuxVerse.Base", cosi' la versione per
  Android 12 e successivi (cartella values-v31) puo' aggiungere soltanto le
  righe della schermata di avvio, senza riscrivere tutto il resto.
-->
<resources>

    <style name="Theme.LuxVerse" parent="Theme.LuxVerse.Base" />

    <style name="Theme.LuxVerse.Base" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/lux_background</item>
        <item name="android:colorBackground">@color/lux_background</item>
        <item name="android:textColorPrimary">@color/lux_text</item>
        <item name="android:textColorSecondary">@color/lux_text_muted</item>
        <item name="android:statusBarColor">@color/lux_background</item>
        <item name="android:navigationBarColor">@color/lux_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/lux_accent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Pulsanti: fondo grafite, testo oro, angoli piccoli. -->
    <style name="LuxButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/lux_accent_light</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="LuxButton.Quiet" parent="LuxButton">
        <item name="android:textColor">@color/lux_text_muted</item>
    </style>

</resources>
