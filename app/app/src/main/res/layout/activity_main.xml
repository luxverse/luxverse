<?xml version="1.0" encoding="utf-8"?>
<!--
  Una sola schermata, tre strati sovrapposti:
    1. la WebView (le pagine del sito);
    2. il velo di attesa, che sta sopra finche' la pagina non ha davvero
       qualcosa da leggere (l'hosting consegna prima una pagina vuota);
    3. la pagina di cortesia, che si vede solo se il sito non risponde.

  IL VELO, RIFATTO (17/10/2026)
  Prima era un logo immagine da 128 dp + rotella che gira + "Loading" fermo:
  pesante da disegnare, e non diceva niente su cosa stesse succedendo.
  Adesso e' una cosa sola, leggera e onesta:
    - il marchio, scritto con il carattere (nessuna immagine da caricare);
    - una linea da 2 dp che avanza con l'avanzamento VERO della pagina,
      non con una rotella che gira a vuoto;
    - una riga di stato che cambia ("Connessione...", "Caricamento...",
      "Preparazione..."): se il sito tarda, si capisce a che punto e';
    - una riga sottile in cima allo schermo, visibile anche sopra il sito,
      che sparisce quando la pagina e' pronta.
  Niente rotelle, niente ombre, niente animazioni continue: solo un
  avanzamento vero. Cosi' la schermata non pesa e non sembra mai bloccata.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lux_background">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- BOTTONE INDIETRO (24/10/2026).
         Sta in basso a sinistra, sopra la pagina e sotto il velo: si vede
         solo quando c'e' davvero una pagina precedente dentro il sito
         (MainActivity lo accende e lo spegne). Non ruba spazio al sito:
         e' sovrapposto, come i comandi di un browser. -->
    <ImageButton
        android:id="@+id/backBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_lux_back"
        android:contentDescription="@string/back"
        android:elevation="6dp"
        android:scaleType="center"
        android:src="@drawable/ic_lux_back"
        android:visibility="gone" />

    <!-- Filo in cima: si vede sopra tutto, anche a pagina caricata non
         c'e' piu'. Non copre niente e non intercetta tocchi. -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/lux_accent" />

    <!-- ===== VELO DI ATTESA ===== -->
    <LinearLayout
        android:id="@+id/veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lux_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="@string/mark"
            android:textColor="@color/lux_text"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.55"
            android:text="@string/mark_sub"
            android:textColor="@color/lux_text_muted"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/veilProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="132dp"
            android:layout_height="2dp"
            android:layout_marginTop="26dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/lux_surface"
            android:progressTint="@color/lux_accent" />

        <TextView
            android:id="@+id/veilStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.16"
            android:text="@string/loading_connecting"
            android:textColor="@color/lux_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== PAGINA DI CORTESIA ===== -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lux_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="@string/mark"
            android:textColor="@color/lux_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/lux_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/offline_text"
            android:textColor="@color/lux_text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retry"
            style="@style/LuxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/retry" />

        <Button
            android:id="@+id/openInBrowser"
            style="@style/LuxButton.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/open_in_browser" />
    </LinearLayout>

</FrameLayout>
