<?xml version="1.0" encoding="utf-8"?>
<!-- Sfondo app: grafite con un'unica luce calda in alto -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1A1D22"
                android:endColor="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.78"
                android:centerY="0.06"
                android:startColor="#1FD8A93C"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
