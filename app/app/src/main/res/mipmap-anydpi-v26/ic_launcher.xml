<?xml version="1.0" encoding="utf-8"?>
<!--
  Da Android 8 l'icona non e' piu' un disegno solo: sono due strati, uno
  sfondo e un segno, e il telefono li compone nella forma che vuole lui
  (cerchio, quadrato stondato, goccia...). Cosi' il marchio non viene mai
  tagliato. Sfondo grafite, segno ufficiale (23/11/2026).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
