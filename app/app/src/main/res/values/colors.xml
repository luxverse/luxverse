<?xml version="1.0" encoding="utf-8"?>
<!--
  I colori NON sono scelti a parte: sono gli stessi del sito (assets/css/site.css,
  blocco :root). Cosi' l'app e le pagine non sembrano due cose diverse: grafite
  scura e un solo accento, l'oro.

  Fra parentesi c'e' il nome del colore nel foglio di stile del sito, per
  ritrovarli se un giorno cambiano.
-->
<resources>
    <color name="lux_background">#0A0B0D</color>   <!-- grafite di fondo (token ink, bg) -->
    <color name="lux_surface">#15181B</color>      <!-- superficie rialzata (token ink 3) -->
    <color name="lux_card">#121417</color>         <!-- fondo delle schede (card bg) -->
    <color name="lux_text">#EDE9E0</color>         <!-- testo principale (token bone, text) -->
    <color name="lux_text_muted">#A5A197</color>   <!-- testo secondario (text light) -->
    <color name="lux_accent">#D8A93C</color>       <!-- oro, l'unico accento (token gold) -->
    <color name="lux_accent_light">#F0CE86</color> <!-- oro chiaro (gold light) -->
    <color name="ic_launcher_background">#0A0B0D</color>
</resources>
