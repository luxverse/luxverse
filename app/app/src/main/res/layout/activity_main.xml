<?xml version="1.0" encoding="utf-8"?>
<!--
  Una sola schermata, tre strati sovrapposti:
    1. la WebView (le pagine del sito);
    2. il velo di attesa, che sta sopra finche' la pagina non ha davvero
       qualcosa da leggere (l'hosting consegna prima una pagina vuota);
    3. la pagina di cortesia, che si vede solo se il sito non risponde.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lux_background">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/lux_surface"
        android:progressTint="@color/lux_accent" />

    <!-- ===== VELO DI ATTESA ===== -->
    <FrameLayout
        android:id="@+id/veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lux_background"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_foreground" />

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/lux_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/loading"
                android:textColor="@color/lux_text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== PAGINA DI CORTESIA ===== -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lux_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/lux_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/offline_text"
            android:textColor="@color/lux_text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retry"
            style="@style/LuxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/retry" />

        <Button
            android:id="@+id/openInBrowser"
            style="@style/LuxButton.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/open_in_browser" />
    </LinearLayout>

</FrameLayout>
