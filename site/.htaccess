# Blocca accesso diretto ai file di configurazione e ai segreti.
# Copre anche QUALSIASI *.local.php e *.secret.php: se domani si aggiunge
# un file di credenziali nuovo (deploy.local.php, o altro) e' gia' protetto,
# non serve ricordarsi di elencarlo.
# NOTA: admin_setup.php NON è bloccato perché va aperto una volta nel browser
# (è protetto dalla password admin attuale). ELIMINALO dal server dopo l'uso.
<FilesMatch "^(config\.php|.*\.local\.php|.*\.secret\.php|secrets\.php|\.gitignore|\.gitattributes)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# I file di credenziali non devono nemmeno finire nella cache o nei motori.
<IfModule mod_headers.c>
    <FilesMatch "\.(local|secret)\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# TUTTI GLI STRUMENTI VIVONO IN UN UNICO FILE (tool.php).
# Le URL pubbliche NON cambiano: /riassumi.php, /workmepass.php ecc.
# Ogni richiesta a una pagina-strumento inesistente viene servita da tool.php,
# che riconosce lo strumento dal nome richiesto.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # PAGINE DI CONTENUTO -> FILE .html
    # Da 17/10/2026 privacy, termini, chi siamo, FAQ, percorso, linea del
    # tempo, codice aperto e condividi sono file gia' pronti (.html): aprirli
    # non fa lavorare il server. I vecchi indirizzi .php (link salvati,
    # motori di ricerca, messaggi vecchi) portano li' con un reindirizzamento
    # permanente, cosi' non esistono due copie della stessa pagina.
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$) [NC]
    RewriteRule ^(privacy|terms|chi-siamo|faq|roadmap|linea-del-tempo|codice-aperto|condividi)\.php$ /en/$1.html? [R=301,L]
    RewriteRule ^(privacy|terms|chi-siamo|faq|roadmap|linea-del-tempo|codice-aperto|condividi)\.php$ /$1.html? [R=301,L]

    # Pagine informative -> info.php (un solo file per chi-siamo, linea del
    # tempo, privacy, terms, faq, assistenza, contattaci e status). Gli URL
    # pubblici non cambiano: /privacy.php resta /privacy.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(chi-siamo|privacy|terms|faq|assistenza|contattaci|status)\.php$ info.php?__info=$1 [L,QSA]

    # Linea del Tempo: indirizzo principale in italiano + alias corto
    # /timeline.php. info.php normalizza i due nomi sulla stessa sezione.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(linea-del-tempo|timeline)\.php$ info.php?__info=$1 [L,QSA]

    # /<strumento>.php  ->  tool.php
    # I trattini servono al catalogo generato (es. /riassumi-email-flash.php).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([a-zA-Z0-9_-]+)\.php$ tool.php?__lux=$1 [L,QSA]

    # Compatibilita' con le vecchie URL /progetti/<strumento>.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^progetti/([a-zA-Z0-9_-]+)\.php$ tool.php?__lux=$1 [L,QSA]
</IfModule>

# Blocca directory data/
RedirectMatch 403 ^/data/.*$

# Impedisci listazione directory di progetti/
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Blocca file .md/.log sensibili (i .json sono già bloccati dentro data/;
# manifest.json resta accessibile alla radice per la PWA)
<FilesMatch "\.(md|log|env|py|pyc|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# La cartella tools/ contiene solo script di sviluppo (generatore icone,
# lint, audit): non deve mai essere raggiungibile dal web, anche se
# venisse caricata per errore sul server.
RedirectMatch 403 ^/tools/.*$

# Blocca accesso a .htaccess stesso
<Files ".htaccess">
    Order Allow,Deny
    Deny from all
</Files>

# Blocca accesso a .git se per caso lo inizializzi
RedirectMatch 403 ^/\.git/.*$

# Header di sicurezza
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compressione GZIP per velocità
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain text/xml
</IfModule>

# Cache browser per asset statici
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# APK — mime corretto + nessuna cache (così l'aggiornamento dell'app è immediato)
<IfModule mod_mime.c>
    AddType application/vnd.android.package-archive .apk
</IfModule>
<IfModule mod_expires.c>
    ExpiresByType application/vnd.android.package-archive "access plus 0 seconds"
</IfModule>